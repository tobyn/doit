#   "Not Moving" [branch] - unit is not moving
#   "Path Blocked" [branch] - unit is path blocked
#   "No Result" [branch] - unit is out of visual range
fn is_moving(unit) exec(not_moving, path_blocked, no_result, moving) {
    # frame: {"op": "is_moving", "0": "Not Moving" [exec], "1": "Path Blocked" [exec],
    #   "2": "No Result" [exec], "3": unit [in], "next": "Moving"}
