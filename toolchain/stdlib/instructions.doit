fn for_recipe_ingredients(recipe) exec(body, done) {
    instruction "for_recipe_ingredients" {
        0: recipe
        1: @1
        detach next: body(@1)
        exec 2: done
    }
}

# Loops through each ingredient required to repair a unit.
#   target [in] - unit
#   ingredient [out] - repair ingredient
