# Filters the passed unit.
#   unit [in] - unit to filter, defaults to self
#   filter [in] - filter to check
#   filter_2 [in, optional] - second filter
#   filter_3 [in, optional] - third filter
#   "Failed" [branch] - did not match filter
fn match(unit, filter, filter_2 filter_2, filter_3 filter_3) exec(failed) {
    # frame: {"op": "match", "0": unit [in], "1": filter [in], "2": filter_2 [in],
    #   "3": filter_3 [in], "4": "Failed" [exec]}
    instruction "match" {
        0: unit
        1: filter
        2: filter_2
        3: filter_3
        exec 4: failed
    }
}

# Get memory array element.
#   index [in] - array identifier and index
#   value [out]
fn memory_get(index) {
    # frame: {"op": "memory_get", "0": index [in], "1": value [out]}
    return instruction "memory_get" {
        0: index
        1: @1
    }
}

# Insert value into memory array.
#   index [in] - array identifier and index
#   value [in]
fn memory_insert(index, value) {
    # frame: {"op": "memory_insert", "0": index [in], "1": value [in]}
