# This file defines all the built-in game instructions defined in Desynced's `instructions.lua`

skip prelude

# Mode enums for instructions with combo selectors.
# Values are 1-based to match the game's combo indexing.

enum MoveMode { Sync = 1, Async }
enum AmountMode { Specified = 1, UpTo }
enum BitwiseMode {
    And = 1, Or, Xor, Not, ShiftLeft, ShiftRight,
    CompareEqual, CompareLarger, CompareLargerOrEqual,
    Add, Subtract, Multiply, Divide, Modulo
}
enum LockSlotMode { OnlyUnfixed = 1, OverrideFixed }
enum CountSlotType { All = 1, Storage, Gas, Virus, Anomaly, Drone, Garage, Alien, Satellite }
enum CountItemMode { Remaining = 1, Reserved }
enum UnitInfoStat { Durability = 1, VisibilityRange, MovementSpeed }
enum PowerInfoStat { Producing = 1, Requiring, Efficiency, Consuming, Receiving, Transmitting }
enum ItemInfoStat {
    MaxStack = 1, AttackRange, MinRange, Damage, DamageType, BlastRadius,
    MoveAndFire, DPS, PowerStorage, DrainRate, ChargeRate, Bandwidth,
    DroneRange, Power
}
enum SignalFilterMode {
    Match = 1, Exact, NotExact, LessThan, ExactOrLessThan,
    MoreThan, ExactOrMoreThan
}

# Abort an owned construction.
#   target [in] - target construction
fn abort_construction(target) {
    # frame: {"op": "abort_construction", "0": target [in]}
    instruction "abort_construction" {
        0: target
    }
}

# Adds a number or coordinate to another number or coordinate.
#   to [in]
#   num [in]
#   result [out]
fn add(to, num) {
    # frame: {"op": "add", "0": to [in], "1": num [in], "2": result [out]}
    return instruction "add" {
        0: to
        1: num
        2: @1
    }
}

# Generic component activation.
#   "Failed" [branch] - if activation failed
fn activate() exec(failed) {
    # frame: {"op": "activate", "0": "Failed" [exec]}
    instruction "activate" {
        exec 0: failed
    }
}

# Moves towards a location stopping to attack any enemies encountered.
#   target [in] - target unit or coordinate
fn attack_move(target) {
    # frame: {"op": "attack_move", "0": target [in]}
    instruction "attack_move" {
        0: target
    }
}

# Performs a bitwise operation on two values.
#   a [in] - first value (or value for NOT)
#   b [in, optional] - second value (ignored for NOT)
#   result [out] - bitwise operation result
fn bitwise_op(a, b b, mode mode) {
    # frame: {"op": "bitwise_op", "0": a [in], "1": b [in], "2": result [out], "c": <mode>}
    return instruction "bitwise_op" {
        0: a
        1: b
        2: @1
        c: mode
    }
}

# Places a construction site for a specific structure.
#   coordinate [in, optional] - target location, or current location if not specified
#   rotation [in, optional] - building rotation (0 to 3), default 0
#   "Construction Failed" [branch] - where to continue if construction fails
fn build(coordinate, rotation) exec(failed) {
    # frame: {"op": "build", "0": coordinate [in], "1": rotation [in],
    #   "2": "Construction Failed" [exec], "bp": <blueprint>, "frame": <frame_type>}
    # (low confidence: bp/frame fields inferred from build_produce_ui)
    instruction "build" {
        0: coordinate
        1: rotation
        exec 2: failed
    }
}

# Places a building to be registered.
#   coordinate [in, optional] - target location, or current location if not specified
#   rotation [in, optional] - building rotation (0 to 3), default 0
#   id [in] - id to register with
#   "If Working" [branch] - where to continue if the unit started working
#   "Construction Failed" [branch] - where to continue if construction fails
fn build_registered(coordinate, rotation, id) exec(working, failed) {
    # frame: {"op": "build_registered", "0": coordinate [in], "1": rotation [in],
    #   "2": id [in], "3": "If Working" [exec], "4": "Construction Failed" [exec],
    #   "bp": <blueprint>, "frame": <frame_type>}
    # (low confidence: bp/frame fields inferred from build_produce_ui)
    instruction "build_registered" {
        0: coordinate
        1: rotation
        2: id
        exec 3: working
        exec 4: failed
    }
}


# Returns if a unit can produce an item.
#   item [in] - production item
#   component [in, optional] - component to check
#   "Can Produce" [branch] - where to continue if the item can be produced
#   "Cannot Produce" [branch] - where to continue if the item cannot be produced
fn can_produce(item, component component) exec(can, cannot) {
    # frame: {"op": "can_produce", "0": "Can Produce" [exec], "1": item [in],
    #   "2": component [in], "next": "Cannot Produce"}
    instruction "can_produce" {
        exec 0: can
        1: item
        2: component
        next: cannot
    }
}

# Divert program depending on location of a unit or coordinate.
#   target [in, optional] - the unit or coordinate to check (if not self)
#   "Valley" [branch] - where to continue if in a valley
#   "Plateau" [branch] - where to continue if on a plateau
#   "No Visibility" [branch, optional] - no visibility on target
fn check_altitude(target) exec(valley, plateau, no_visibility) {
    # frame: {"op": "check_altitude", "0": target [in], "1": "Valley" [exec],
    #   "2": "Plateau" [exec], "next": "No Visibility"}
    instruction "check_altitude" {
        0: target
        exec 1: valley
        exec 2: plateau
        next: no_visibility
    }
}

# Checks the battery level of a unit.
#   unit [in, optional] - the unit to check (if not self)
#   "Full" [branch] - where to continue if battery is fully recharged
fn check_battery(unit) exec(full) {
    # frame: {"op": "check_battery", "0": "Full" [exec], "1": unit [in]}
    instruction "check_battery" {
        exec 0: full
        1: unit
    }
}

# Checks if a specific bit is set in a number.
#   value [in] - the number to check
#   bit_index [in] - bit index (1 = least significant)
#   "Bit Set" [branch] - where to continue if bit is set
#   "Bit Clear" [branch] - where to continue if bit is clear
fn check_bit(value, bit_index) exec(clear, set) {
    # frame: {"op": "check_bit", "0": "Bit Clear" [exec], "1": value [in],
    #   "2": bit_index [in], "next": "Bit Set"}
    instruction "check_bit" {
        exec 0: clear
        1: value
        2: bit_index
        next: set
    }
}

# Divert program depending on whether a unit or coordinate is in the blight.
#   target [in, optional] - the unit or coordinate to check (if not self)
#   "Blight" [branch] - where to continue if in the blight
fn check_blightness(target) exec(blight) {
    # frame: {"op": "check_blightness", "0": target [in], "1": "Blight" [exec]}
    instruction "check_blightness" {
        0: target
        exec 1: blight
    }
}

# Checks the efficiency of the logistics network the unit is on.
#   unit [in, optional] - the unit to check (if not self)
#   "Full" [branch] - where to continue if at full efficiency
fn check_grid_effeciency(unit) exec(full) {
    # frame: {"op": "check_grid_effeciency", "0": "Full" [exec], "1": unit [in]}
    instruction "check_grid_effeciency" {
        exec 0: full
        1: unit
    }
}

# Check a unit's health.
#   unit [in, optional] - the unit to check (if not self)
#   "Full" [branch] - where to continue if at full health
fn check_health(unit) exec(full) {
    # frame: {"op": "check_health", "0": "Full" [exec], "1": unit [in]}
    instruction "check_health" {
        exec 0: full
        1: unit
    }
}

# Divert program depending on comparison of two numbers.
#   value [in] - the value to check
#   compare [in] - the number to check against
#   "If Equal" [branch] - where to continue if values are equal
#   "If Larger" [branch] - where to continue if value is larger than compare
#   "If Smaller" [branch] - where to continue if value is smaller than compare
fn check_number(value, compare) exec(larger, smaller, equal) {
    # frame: {"op": "check_number", "0": "If Larger" [exec], "1": "If Smaller" [exec],
    #   "2": value [in], "3": compare [in], "next": "If Equal"}
    instruction "check_number" {
        exec 0: larger
        exec 1: smaller
        2: value
        3: compare
        next: equal
    }
}

# Checks if free space is available for an item and amount.
#   item [in] - item and amount to check
#   "Can't Fit" [branch] - where to continue if it can't fit
fn checkfreespace(item) exec(cant_fit) {
    # frame: {"op": "checkfreespace", "0": "Can't Fit" [exec], "1": item [in]}
    instruction "checkfreespace" {
        exec 0: cant_fit
        1: item
    }
}

# Clear all register links on this unit.
fn clear_all_links() {
    # frame: {"op": "clear_all_links"}
    instruction "clear_all_links"
}

# Clear a register link.
#   from [in] - component/register index to start clearing
#   from_index [in, optional] - component index if multiple are equipped
#   to [in] - component/register index to end clearing
#   to_index [in, optional] - component index if multiple are equipped
fn clear_link(from, to, from_index from_index, to_index to_index) {
    # frame: {"op": "clear_link", "0": from [in], "1": from_index [in],
    #   "2": to [in], "3": to_index [in]}
    instruction "clear_link" {
        0: from
        1: from_index
        2: to
        3: to_index
    }
}

# Clears a research from the research queue, or entire queue if no tech passed.
#   tech [in] - tech to remove from research queue
fn clear_research(tech) {
    # frame: {"op": "clear_research", "0": tech [in]}
    instruction "clear_research" {
        0: tech
    }
}

# Returns a coordinate made from x and y values.
#   x [in]
#   y [in]
#   result [out]
fn combine_coordinate(x, y) {
    # frame: {"op": "combine_coordinate", "0": x [in], "1": y [in], "2": result [out]}
    return instruction "combine_coordinate" {
        0: x
        1: y
        2: @1
    }
}

# Combine separate parameters into a register.
#   num [in]
#   unit [in]
#   register [out]
#   x [in, optional]
#   y [in, optional]
fn combine_register(num, unit, x x, y y) {
    # frame: {"op": "combine_register", "0": num [in], "1": unit [in],
    #   "2": register [out], "3": x [in], "4": y [in]}
    return instruction "combine_register" {
        0: num
        1: unit
        2: @1
        3: x
        4: y
    }
}

# Compares two units.
#   unit_1 [in]
#   unit_2 [in]
#   "If Equal" [branch] - where to continue if the units are the same
#   "If Different" [branch] - where to continue if the units differ
fn compare_entity(unit_1, unit_2) exec(different, equal) {
    # frame: {"op": "compare_entity", "0": "If Different" [exec], "1": unit_1 [in],
    #   "2": unit_2 [in], "next": "If Equal"}
    instruction "compare_entity" {
        exec 0: different
        1: unit_1
        2: unit_2
        next: equal
    }
}

# Compares item or unit type.
#   value_1 [in]
#   value_2 [in]
#   "If Equal" [branch] - where to continue if the types are the same
#   "If Different" [branch] - where to continue if the types differ
fn compare_item(value_1, value_2) exec(different, equal) {
    # frame: {"op": "compare_item", "0": "If Different" [exec], "1": value_1 [in],
    #   "2": value_2 [in], "next": "If Equal"}
    instruction "compare_item" {
        exec 0: different
        1: value_1
        2: value_2
        next: equal
    }
}

# Compares registers for equality.
#   value_1 [in]
#   value_2 [in]
#   "If Equal" [branch] - where to continue if the registers are the same
#   "If Different" [branch] - where to continue if the registers differ
fn compare_register(value_1, value_2) exec(different, equal) {
    # frame: {"op": "compare_register", "0": "If Different" [exec], "1": value_1 [in],
    #   "2": value_2 [in], "next": "If Equal"}
    instruction "compare_register" {
        exec 0: different
        1: value_1
        2: value_2
        next: equal
    }
}

# Connects the unit to the logistics network.
fn connect() {
    # frame: {"op": "connect"}
    instruction "connect"
}

# Counts the number of the passed item in the unit's inventory.
#   item [in] - item to count
#   result [out] - number of this item in inventory
#   unit [in, optional] - the unit to check (if not self)
fn count_item(item, unit unit, mode mode) {
    # frame: {"op": "count_item", "0": item [in], "1": result [out], "2": unit [in],
    #   "c": <mode>}
    return instruction "count_item" {
        0: item
        1: @1
        2: unit
        c: mode
    }
}

# Returns the number of slots in this unit of the given type.
#   result [out] - number of slots
#   unit [in, optional] - the unit to check (if not self)
fn count_slots(unit unit, type type) {
    # frame: {"op": "count_slots", "0": result [out], "1": unit [in], "c": <mode>}
    return instruction "count_slots" {
        0: @1
        1: unit
        c: type
    }
}

# Debug print to log.
#   value [in] - value to print
fn debug_print(value) {
    # frame: {"op": "debug_print", "0": value [in]}
    instruction "debug_print" {
        0: value
    }
}

# Deploys the first found held unit at the specified location.
#   coord [in] - location to deploy
fn deploy(coord) {
    # frame: {"op": "deploy", "0": coord [in]}
    instruction "deploy" {
        0: coord
    }
}

# Disable unit to deliver on transport route.
fn disable_transport_route() {
    # frame: {"op": "disable_transport_route"}
    instruction "disable_transport_route"
}

# Disconnects the unit from the logistics network.
fn disconnect() {
    # frame: {"op": "disconnect"}
    instruction "disconnect"
}

# Divides a number or coordinate by another number or coordinate.
#   from [in]
#   num [in]
#   result [out]
fn div(from, num) {
    # frame: {"op": "div", "0": from [in], "1": num [in], "2": result [out]}
    return instruction "div" {
        0: from
        1: num
        2: @1
    }
}

# Drop off items at a unit or location.
#   destination [in] - unit or destination to bring items to
#   item_amount [in, optional] - item and amount to drop off
#   "Path Blocked" [branch] - if path to destination was blocked
fn dodrop(destination, item_amount item_amount, mode mode) exec(path_blocked) {
    # frame: {"op": "dodrop", "0": destination [in], "1": item_amount [in],
    #   "2": "Path Blocked" [exec], "c": <mode>}
    instruction "dodrop" {
        0: destination
        1: item_amount
        exec 2: path_blocked
        c: mode
    }
}

# Moves to another unit or within a range of another unit.
#   target [in] - unit to move to; the number specifies the range
#   unit [in, optional] - target unit (if not self)
#   "Path Blocked" [branch] - if path is blocked
fn domove(target, unit unit, mode mode) exec(path_blocked) {
    # frame: {"op": "domove", "0": target [in], "1": "Path Blocked" [exec],
    #   "2": unit [in], "c": <mode>}
    instruction "domove" {
        0: target
        exec 1: path_blocked
        2: unit
        c: mode
    }
}

# Deprecated: use domove
# Starts movement but does not wait for completion.
#   target [in] - unit to move to
fn domove_async(target) {
    # frame: {"op": "domove_async", "0": target [in]}
    instruction "domove_async" {
        0: target
    }
}

# Deprecated: use domove
# Moves toward a target location until within a specified range.
#   target [in] - unit to move to; the number specifies the range
fn domove_range(target) {
    # frame: {"op": "domove_range", "0": target [in]}
    instruction "domove_range" {
        0: target
    }
}

# Picks up items from a unit.
#   source [in] - unit to take items from
#   item_amount [in, optional] - item and amount to pick up
#   "Path Blocked" [branch] - if path to source was blocked
fn dopickup(source, item_amount item_amount, mode mode) exec(path_blocked) {
    # frame: {"op": "dopickup", "0": source [in], "1": item_amount [in],
    #   "2": "Path Blocked" [exec], "c": <mode>}
    instruction "dopickup" {
        0: source
        1: item_amount
        exec 2: path_blocked
        c: mode
    }
}

# Enable unit to deliver on transport route.
fn enable_transport_route() {
    # frame: {"op": "enable_transport_route"}
    instruction "enable_transport_route"
}

# Equips a component if it exists in the unit's inventory.
#   component [in] - component to equip
#   slot_index [in, optional] - individual slot to equip from
#   "No Component" [branch] - if the unit doesn't hold the requested component
fn equip_component(component, slot_index slot_index) exec(no_component) {
    # frame: {"op": "equip_component", "0": "No Component" [exec], "1": component [in],
    #   "2": slot_index [in]}
    instruction "equip_component" {
        exec 0: no_component
        1: component
        2: slot_index
    }
}

# Equips a component on an external unit if it exists in that unit's inventory.
#   unit [in] - the unit to equip component on
#   component [in] - component to equip
#   slot_index [in, optional] - individual slot to equip from
#   "No Component" [branch] - if the unit doesn't hold the requested component
fn equip_component_remotely(unit, component, slot_index slot_index) exec(no_component) {
    # frame: {"op": "equip_component_remotely", "0": unit [in],
    #   "1": "No Component" [exec], "2": component [in], "3": slot_index [in]}
    instruction "equip_component_remotely" {
        0: unit
        exec 1: no_component
        2: component
        3: slot_index
    }
}

# Counts the number of the passed item in the faction's logistics network.
#   item [in] - item to count
#   result [out] - number of this item in the faction
#   "None" [branch] - when none of this item exists
fn faction_item_amount(item) exec(none) {
    # frame: {"op": "faction_item_amount", "0": item [in], "1": result [out],
    #   "2": "None" [exec]}
    instruction "faction_item_amount" {
        0: item
        1: @1
        exec 2: none
    }
}

# Loops through equipped components.
#   component [out] - equipped component
#   index [out, optional] - index of the component
# See also: each_component (iterator version)
fn for_component() exec(body, done) {
    instruction "for_component" {
        0: @1
        1: @2
        detach next: body(@1, @2)
        exec 2: done
    }
}

# Scans for nearby resources in power field or visibility range.
#   resource [out]
# See also: each_nearby_resource (iterator version)
fn for_count_resources() exec(body, done) {
    instruction "for_count_resources" {
        0: @1
        detach next: body(@1)
        exec 1: done
    }
}

# Loops through all units in visibility range matching filters.
#   range [in] - range (up to visibility range)
#   filter [in] - filter to check
#   filter_2 [in, optional] - second filter
#   filter_3 [in, optional] - third filter
#   unit [out] - current unit in loop
# See also: each_entity_in_range (iterator version)
fn for_entities_in_range(range, filter, filter_2 filter_2, filter_3 filter_3) exec(body, done) {
    instruction "for_entities_in_range" {
        0: range
        1: filter
        2: filter_2
        3: filter_3
        4: @1
        detach next: body(@1)
        exec 5: done
    }
}

# Loops through inventory slots.
#   item [out] - item inventory
#   reserved_stack [out, optional] - items reserved for outgoing order or recipe
#   unreserved_stack [out, optional] - items available
#   reserved_space [out, optional] - space reserved for an incoming order
#   unreserved_space [out, optional] - remaining space
# See also: each_inventory_item (iterator version)
fn for_inventory_item() exec(body, done) {
    instruction "for_inventory_item" {
        0: @1
        detach next: body(@1, @2, @3, @4, @5)
        exec 1: done
        2: @2
        3: @3
        4: @4
        5: @5
    }
}

# Loops through all numbers in a range.
#   from [in] - loop start number
#   to [in] - loop end number
#   step [in, optional] - increment step, defaults to -1 or 1 based on inputs
#   value [out] - current number
# See also: each_number (iterator version)
fn for_number(from, to, step step) exec(body, done) {
    instruction "for_number" {
        0: from
        1: to
        2: step
        3: @1
        detach next: body(@1)
        exec 4: done
    }
}

# Gets all producers for a production with their production time.
#   production [in] - production
#   producer [out] - producer
# See also: each_producer (iterator version)
fn for_producers(production) exec(body, done) {
    instruction "for_producers" {
        0: production
        1: @1
        detach next: body(@1)
        exec 2: done
    }
}

# Loops through all unlocked items a production component can produce.
#   producer [in] - producer to check
#   item [out] - produceable item
# See also: each_producer_item (iterator version)
fn for_producers_items(producer) exec(body, done) {
    instruction "for_producers_items" {
        0: producer
        1: @1
        detach next: body(@1)
        exec 2: done
    }
}

# Loops through recipe ingredients.
#   recipe [in]
