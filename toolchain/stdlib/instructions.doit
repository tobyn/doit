# Deprecated: use for_signal_match
# Loops through all units with a signal.
#   signal [in] - signal
#   unit [out] - unit with signal
# See also: each_signal (iterator version)
fn for_signal(signal) exec(body, done) {
    instruction "for_signal" {
        0: signal
        1: @1
        detach next: body(@1)
        exec 2: done
    }
}

# Loops through all units with a signal of similar type.
#   signal [in] - signal
#   unit [out] - found unit with signal
#   found_signal [out, optional] - found signal
# See also: each_signal_match (iterator version)
fn for_signal_match(signal, mode mode) exec(body, done) {
    instruction "for_signal_match" {
        0: signal
        1: @1
        2: @2
        detach next: body(@1, @2)
        exec 3: done
        c: mode
    }
}

# Collect information for running the auto base controller.
#   range [in] - range of operation
fn gather_information(range) {
    # frame: {"op": "gather_information", "0": range [in]}
    instruction "gather_information" {
        0: range
    }
}

# Gets the source, target, and amount data from the current active order.
#   source [out]
#   target [out]
