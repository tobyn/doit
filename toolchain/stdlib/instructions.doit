#   missing [out] - missing repair item, scanner component, or unpowered
#   "Failed" [branch] - missing item, component, or power
fn solve(target) exec(failed) {
    # frame: {"op": "solve", "0": target [in], "1": missing [out],
    #   "2": "Failed" [exec]}
    instruction "solve" {
        0: target
