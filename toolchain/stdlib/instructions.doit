        detach next: body(@1)
        exec 1: done
    }
}

# Loops through research ingredients.
#   research [in]
#   ingredient [out] - research ingredient
# See also: each_research_ingredient (iterator version)
fn for_research_ingredients(research) exec(body, done) {
    instruction "for_research_ingredients" {
