#   channel [in, optional] - request on a specific logistics channel (1-4)
fn request_wait(item, channel channel, mode mode) {
    # frame: {"op": "request_wait", "0": item [in], "1": channel [in], "c": <mode>}
    instruction "request_wait" {
        0: item
        1: channel
