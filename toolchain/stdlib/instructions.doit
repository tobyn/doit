        0: index
        1: value
    }
}

# Get length of memory array.
#   index [in] - array identifier
#   value [out]
fn memory_length(index) {
    # frame: {"op": "memory_length", "0": index [in], "1": value [out]}
    return instruction "memory_length" {
        0: index
        1: @1
    }
}

# Loops through memory array or known array identifiers.
#   id [in] - array identifier, or empty to loop through known identifiers
#   value [out]
#   index [out, optional]
# See also: each_memory_entry (iterator version)
fn memory_loop(id) exec(body, done) {
    instruction "memory_loop" {
        0: id
        1: @1
        detach next: body(@1, @2)
        exec 2: done
        3: @2
    }
}

# Remove value from memory array.
#   index [in] - array identifier and index
#   old_value [out] - removed value
fn memory_remove(index) {
    # frame: {"op": "memory_remove", "0": index [in], "1": old_value [out]}
    return instruction "memory_remove" {
        0: index
        1: @1
    }
}

# Set memory array value at a given index.
