#   old [out] - previous value
fn memory_set(index, value) {
    # frame: {"op": "memory_set", "0": index [in], "1": value [in], "2": old [out]}
    return instruction "memory_set" {
        0: index
        1: value
        2: @1
    }
}

# Mine a single resource deposit.
