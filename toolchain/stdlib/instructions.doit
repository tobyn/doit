fn stop() {
    # frame: {"op": "stop"}
    instruction "stop"
}

# Subtracts a number or coordinate from another number or coordinate.
#   from [in]
#   num [in]
#   result [out]
fn sub(from, num) {
    # frame: {"op": "sub", "0": from [in], "1": num [in], "2": result [out]}
    return instruction "sub" {
        0: from
        1: num
        2: @1
    }
}

# Filters the passed unit or item, branching to matching cases.
#   input [in] - unit or item to filter
#   case_1 [in] - case 1 filter
#   case_2 [in, optional] - case 2 filter
#   case_3 [in, optional] - case 3 filter
#   case_4 [in, optional] - case 4 filter
#   case_5 [in, optional] - case 5 filter
#   "Default" [branch] - did not match any filter
#   "1"-"5" [branch] - matched respective case
fn switch(input, case_1, case_2 case_2, case_3 case_3, case_4 case_4, case_5 case_5) exec(match_1, match_2, match_3, match_4, match_5, default) {
    # frame: {"op": "switch", "0": input [in], "1": case_1 [in], "2": "1" [exec],
    #   "3": case_2 [in], "4": "2" [exec], "5": case_3 [in], "6": "3" [exec],
    #   "7": case_4 [in], "8": "4" [exec], "9": case_5 [in], "10": "5" [exec],
    #   "next": "Default"}
    instruction "switch" {
        0: input
        1: case_1
        exec 2: match_1
        3: case_2
        exec 4: match_2
        5: case_3
        exec 6: match_3
        7: case_4
        exec 8: match_4
        9: case_5
        exec 10: match_5
        next: default
    }
}

# Turns on the power of the unit.
fn turnon() {
    # frame: {"op": "turnon"}
    instruction "turnon"
}

# Unequips a component if it exists.
#   component [in] - component to unequip
#   slot_index [in, optional] - individual slot to unequip from
#   "No Component" [branch] - component not found or slot was empty
fn unequip_component(component, slot_index slot_index) exec(no_component) {
    # frame: {"op": "unequip_component", "0": "No Component" [exec],
    #   "1": component [in], "2": slot_index [in]}
    instruction "unequip_component" {
        exec 0: no_component
        1: component
        2: slot_index
    }
}

# Unequips a component on an external unit.
#   unit [in] - the unit to unequip component on
#   component [in] - component to unequip
#   slot_index [in, optional] - individual slot to unequip from
#   "No Component" [branch] - component not found or slot was empty
fn unequip_component_remotely(unit, component, slot_index slot_index) exec(no_component) {
    # frame: {"op": "unequip_component_remotely", "0": unit [in],
    #   "1": "No Component" [exec], "2": component [in], "3": slot_index [in]}
    instruction "unequip_component_remotely" {
        0: unit
        exec 1: no_component
        2: component
        3: slot_index
    }
}

# Divert program depending on unit type.
#   unit [in] - the unit to check
#   "Building" [branch] - unit is a building
#   "Bot" [branch] - unit is a bot
#   "Construction" [branch, optional] - unit is a construction site
#   "No Unit" [branch, optional] - no visible unit passed
fn unit_type(unit) exec(building, bot, construction, no_unit) {
    # frame: {"op": "unit_type", "0": unit [in], "1": "Building" [exec],
    #   "2": "Bot" [exec], "3": "Construction" [exec], "next": "No Unit"}
    instruction "unit_type" {
        0: unit
        exec 1: building
        exec 2: bot
        exec 3: construction
        next: no_unit
    }
}

# Unfix all inventory slots or a specific item slot.
#   slot_index [in, optional] - individual slot to unfix
fn unlock_slots(slot_index slot_index) {
    # frame: {"op": "unlock_slots", "0": slot_index [in]}
    instruction "unlock_slots" {
        0: slot_index
    }
}

# Switch based on type of value.
#   data [in] - data to test
#   "Item" [branch]
#   "Unit" [branch]
#   "Component" [branch]
#   "Tech" [branch, optional]
#   "Value" [branch, optional]
#   "Coord" [branch, optional]
#   "No Match" [branch] - no match
fn value_type(data) exec(item, unit, component, tech, value, coord, no_match) {
    # frame: {"op": "value_type", "0": data [in], "1": "Item" [exec],
    #   "2": "Unit" [exec], "3": "Component" [exec], "4": "Tech" [exec],
    #   "5": "Value" [exec], "6": "Coord" [exec], "next": "No Match"}
    instruction "value_type" {
        0: data
        exec 1: item
        exec 2: unit
        exec 3: component
        exec 4: tech
        exec 5: value
        exec 6: coord
        next: no_match
    }
}

# `wait` is a language keyword — see manual/language.md

# Waits for a component before continuing.
#   component [in] - component to wait for
#   component_index [in, optional] - component index if multiple are equipped
#   "Not Working" [branch, optional] - component isn't currently working
fn wait_component(component, component_index component_index) exec(not_working) {
    # frame: {"op": "wait_component", "0": component [in],
    #   "1": component_index [in], "2": "Not Working" [exec]}
    instruction "wait_component" {
        0: component
        1: component_index
        exec 2: not_working
    }
}
