        1: @1
    }
}

# Writes a value into a component register on an external unit.
#   unit [in] - the unit to set component register on
#   value [in] - value to set
#   to [in] - component and register number to set
#   component_index [in, optional] - component index if multiple are equipped
#   "Failed" [branch, optional] - failed to set register
fn set_reg_remotely(unit, value, to, component_index component_index) exec(failed) {
    # frame: {"op": "set_reg_remotely", "0": unit [in], "1": value [in], "2": to [in],
    #   "3": component_index [in], "4": "Failed" [exec]}
    instruction "set_reg_remotely" {
