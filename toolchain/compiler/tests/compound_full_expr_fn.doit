# AI-generated test
# Compound assignment with full expression RHS in fn body
fn do_compound(inout x, y) {
    x += get_resource_num y
    x -= y > 3
    x += (y > 3 && x < 20)
}

behavior compound_full_expr_fn {
    @name "Compound Full Expr Fn"
    @param inout x "X"
    @param in y "Y"
    do_compound inout $x, $y
}
