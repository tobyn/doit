# AI-generated test
# Tests break in a detached exec block (exits block, iterator continues)

fn my_for_comp(entity) exec(body, done) {
    instruction "for_component" {
        0: entity
        1: @1
        2: @2
        detach next: body(@1, @2)
        exec 3: done
    }
}

behavior exec_block_break {
    @name "Exec Block Break"
    let e = get_self
    my_for_comp(e) {
        body { comp, idx ->
            if comp == null {
                break
            }
            notify "comp", value: comp
        }
        done { notify "done" }
    }
}
