# AI-generated test
# instruction with local 'block continuations that receive data via @N
behavior instr_local_blocks_data {
    @name "Instr Local Blocks Data"

    instruction "check_number" {
        exec 0: 'larger (@1)
        exec 1: 'smaller
        2: $signal
        3: 5
        next: 'equal
    } {
        larger { v -> notify "large", value: v }
        smaller { notify "small" }
        equal { notify "equal" }
    }
}
