# AI-generated test
# Multiple inlinings of the same function get unique variable names
fn locate_self() {
    let me = get_self
    let coord = get_location me
    return coord
}

behavior inline_var_rename_multi {
    @name "Inline Var Rename Multi"
    let a = locate_self
    let b = locate_self
    notify "Done", value: a
}
