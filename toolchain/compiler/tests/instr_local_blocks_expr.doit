# AI-generated test
# instruction with local 'block continuations in expression form
behavior instr_local_blocks_expr {
    @name "Instr Local Blocks Expr"

    let result = instruction "check_number" {
        exec 0: 'larger (@1)
        exec 1: 'smaller
        2: $signal
        3: 5
        next: 'equal
    } {
        larger { v -> v }
        smaller { 0 }
        equal { 5 }
    }

    notify "result", value: result
}
