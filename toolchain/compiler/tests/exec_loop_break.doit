# AI-generated test
# Tests break inside a looping continuation block (emits "last")

fn my_for_comp(entity) exec(body, done) {
    instruction "for_component" {
        0: entity
        1: @1
        2: @2
        for next: body(@1, @2)
        exec 3: done
    }
}

behavior exec_loop_break {
    @name "Exec Loop Break"
    let e = get_self
    my_for_comp(e) {
        for body { comp, idx ->
            if comp == null {
                break
            }
            notify "comp", value: comp
        }
        done { notify "done" }
    }
}
