# AI-generated test
# Tests pure-logic continuation dispatch with multiple data arguments
fn classify(a) exec(big, small) {
    if a > 5 {
        return big(a, 1)
    }
    return small(a, 0)
}

behavior "Exec Cont Data Multi" {
    var x = 10
    classify(x) {
        big { v, flag -> notify "big", value: v; set_reg flag }
        small { v, flag -> notify "small", value: v; set_reg flag }
    }
}
