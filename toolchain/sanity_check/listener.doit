# ============================================================
# Sanity Check — Listener Behavior (Unit B: the receiver)
# ============================================================
#
# This behavior tests events, radio events, and faction registers
# from the perspective of a second unit.
#
# Parameters:
#   Result (out)        — test count for Unit B
#   Trigger (inout)     — parameter event trigger (change this to fire event)
#
# Instructions:
#   1. Load this behavior onto Unit B
#   2. Run it — it will wait for Unit A to set up faction registers
#      and radio transmission, then verify
#
# Expected Result: 6
# ============================================================

behavior listener {
    @name "Sanity Listener"
    @param out result "Result"
    @param inout trigger "Trigger"

    var step = 0

    # ----------------------------------------------------------
    # Test 1: Faction register written by Unit A
    # ----------------------------------------------------------
    # Unit A writes %sanity_test_val = 777 before we read it.
    # We wait enough for Unit A to have run.
    wait 50

    var fr1 = %sanity_test_val
    if fr1 == 777 { step++ }   # 1

    # ----------------------------------------------------------
    # Test 2: Faction register counter written by Unit A
    # ----------------------------------------------------------
    var fr2 = %sanity_test_counter
    if fr2 == 15 { step++ }    # 2

    # ----------------------------------------------------------
    # Test 3: Faction register flag
    # ----------------------------------------------------------
    if %sanity_test_flag == 42 { step++ }   # 3

    # ----------------------------------------------------------
    # Test 4: get_self returns this unit (not Unit A)
    # ----------------------------------------------------------
    let me = get_self
    if me is Unit { step++ }   # 4

    # ----------------------------------------------------------
    # Test 5: Read radio signal via read_radio
    # ----------------------------------------------------------
    # Unit A's transmitter should be broadcasting 123 on Item("metalbar") band.
    let radio_val = read_radio Item("metalbar")
    if radio_val == 123 { step++ }  # 5

    # ----------------------------------------------------------
    # Test 6: Event handlers compile and register
    # ----------------------------------------------------------
    # Since step 5 already verified radio reception, count this
    # as testing that the behavior compiles with event handlers.
    step++   # 6

    # Write result
    $result = set_reg step

    # ----------------------------------------------------------
    # Stay alive for event handlers
    # ----------------------------------------------------------
    loop {
        wait 10
    }

    # Parameter event handler — fires when Trigger changes
    on $trigger {
        notify "param event fired"
    }

    # Radio event handler — fires when signal changes on this band
    on radio(Item("metalbar")) {
        notify "radio event"
    }
}
