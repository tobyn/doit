{
  "name": "doit-language",
  "displayName": "doit Language",
  "description": "Syntax highlighting and language server support for the doit programming language",
  "version": "0.1.0",
  "publisher": "tobyn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tobyn/doit"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:doit"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "doit",
        "aliases": ["doit"],
        "extensions": [".doit"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "doit",
        "scopeName": "source.doit",
        "path": "./syntaxes/doit.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "doit Language",
      "properties": {
        "doit.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Path to the doit binary. Leave empty to use 'doit' from PATH."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "typescript": "^5.3.0"
  }
}
